# PlatformIO / Arduino
# ========================

# Build output
.pio/
*.pio
*.elf
*.bin
*.hex
*.map
*.d
*.cpp.o
*.d.o

# Library dependencies (built by PIO)
.libdeps/

# VSCode / IDE files
.vscode/
.idea/
*.code-workspace

# Mac / Linux / Windows system files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log

# Temporary files
*.tmp
*.swp
*~

# ========================
# .NET host_test artifacts (XInputTest.exe)
# ========================
examples/XInput/XInputAllTest/host_test/*.exe
examples/XInput/XInputAllTest/host_test/*.dll
examples/XInput/XInputAllTest/host_test/*.pdb
examples/XInput/XInputAllTest/host_test/*.deps.json
examples/XInput/XInputAllTest/host_test/*.runtimeconfig.json
bin/
obj/

# ========================
# Python (test scripts, e.g. examples/SInputPlayerLED)
# ========================
__pycache__/
*.pyc
.venv/
